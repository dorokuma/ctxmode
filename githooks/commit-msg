#!/usr/bin/env bash
# Hard commit-message gate — blocks noise, Chinese, and sensitive leaks.
set -euo pipefail

MSG=$(cat "$1")
RED='\033[0;31m'
NC='\033[0m'

die() { echo -e "${RED}❌ REJECTED:${NC} $*"; exit 1; }

# ── 1. Non-ASCII block ──────────────────────────────────────────────
# Chinese / Japanese / Korean / Cyrillic → reject.
if echo "$MSG" | grep -Pn -- '[^\x00-\x7F]' > /dev/null 2>&1; then
  nonascii=$(echo "$MSG" | grep -Pn -- '[^\x00-\x7F]' | head -5)
  die "commit message contains non-ASCII characters. English only.
Offending lines:
$nonascii"
fi

# ── 2. Noise-word block ─────────────────────────────────────────────
# Lines that scream "process diary" instead of "what changed".
NOISE_WORDS=(
  "审计" "审查" "review.*round" "round.*review" "轮审"
  "fix.*audit" "audit.*fix"
  "修了" "改了" "搞了" "弄了"
)
for word in "${NOISE_WORDS[@]}"; do
  if echo "$MSG" | grep -qiE -- "$word"; then
    die "commit message contains noise word: \"$word\"
Write what the change IS, not what process produced it."
  fi
done

# ── 3. Secret-leak block ────────────────────────────────────────────
# Common secret patterns — token, key, password, private key material.
SECRET_PATTERNS=(
  'ghp_[a-zA-Z0-9]{36}'           # GitHub PAT
  'gho_[a-zA-Z0-9]{36}'           # GitHub OAuth
  'ghu_[a-zA-Z0-9]{36}'           # GitHub user token
  'ghs_[a-zA-Z0-9]{36}'           # GitHub server token
  'xox[baprs]-[a-zA-Z0-9-]+'      # Slack
  'sk-[a-zA-Z0-9]{32,}'           # OpenAI / generic API key
  'AKIA[0-9A-Z]{16}'              # AWS Access Key
  '-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----'
  'password\s*[:=]\s*\S+'          # password=
  'api_key\s*[:=]\s*\S+'           # api_key=
  'secret\s*[:=]\s*\S+'            # secret=
)
for pat in "${SECRET_PATTERNS[@]}"; do
  if echo "$MSG" | grep -qiE -- "$pat"; then
    die "commit message appears to contain a secret matching: \"$pat\"
Secrets must never be committed. Use environment variables."
  fi
done

# ── 4. Staged-diff secret check ─────────────────────────────────────
# Also scan the actual staged diff for secrets, not just the message.
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  DIFF=$(git diff --cached HEAD 2>/dev/null || true)
else
  DIFF=$(git diff --cached 2>/dev/null || true)
fi
for pat in "${SECRET_PATTERNS[@]}"; do
  if echo "$DIFF" | grep -qiE -- "$pat"; then
    die "staged changes contain a secret matching: \"$pat\"
Secrets must never be committed. Use environment variables."
  fi
done

exit 0
