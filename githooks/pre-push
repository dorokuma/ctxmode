#!/usr/bin/env bash
# Hard pre-push gate — scans all outgoing commits for secrets and noise.
set -euo pipefail
RED='\033[0;31m'; NC='\033[0m'
die() { echo -e "${RED}❌ PUSH REJECTED:${NC} $*"; exit 1; }

ZERO_SHA="0000000000000000000000000000000000000000"

SECRET_PATTERNS=(
  'ghp_[a-zA-Z0-9]{36}' 'gho_[a-zA-Z0-9]{36}'
  'ghu_[a-zA-Z0-9]{36}' 'ghs_[a-zA-Z0-9]{36}'
  'github_pat_[a-zA-Z0-9_]{20,}'
  'xox[baprs]-[a-zA-Z0-9-]+' 'sk-[a-zA-Z0-9-]{32,}'
  'AKIA[0-9A-Z]{16}' '-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----'
)

check_assignments() {
  local text="$1"
  local target="$2"
  shopt -s nocasematch
  while IFS= read -r line; do
    [[ "$line" =~ ^(\+\+\+|---|@@|-) ]] && continue
    if [[ "$line" =~ (password|api_key|secret)[[:space:]]*[:=]+[[:space:]]*(.*) ]]; then
      local rest="${BASH_REMATCH[2]}"
      local val=""
      if [[ "$rest" =~ ^\"([^\"]*)\" ]]; then
        val="${BASH_REMATCH[1]}"
      elif [[ "$rest" =~ ^\'([^\']*)\' ]]; then
        val="${BASH_REMATCH[1]}"
      elif [[ "$rest" =~ ^([^[:space:];,]+) ]]; then
        val="${BASH_REMATCH[1]}"
      fi
      val=$(echo "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
      local lower
      lower=$(echo "$val" | tr '[:upper:]' '[:lower:]')
      case "$lower" in
        ""|"none"|"optional"|"removed"|"unchanged"|"empty"|"null"|"nil"|"undefined"|"true"|"false"|"todo"|"changeme"|"placeholder"|"<"*">"|"\$"*|"\"\""|"''")
          continue
          ;;
      esac
      if [ ${#val} -ge 6 ]; then
        die "$target contains a hardcoded credential assignment: \"$line\""
      fi
    fi
  done <<< "$text"
}

scan_commit() {
  local sha=$1
  local diff msg combined
  if ! diff=$(git show "$sha" 2>&1); then
    die "git show failed for commit $sha: $diff"
  fi
  if ! msg=$(git log -1 --format=%B "$sha" 2>&1); then
    die "git log failed for commit $sha: $msg"
  fi
  combined="$diff $msg"
  for pat in "${SECRET_PATTERNS[@]}"; do
    if echo "$combined" | grep -qiE -- "$pat"; then
      die "commit $sha contains a secret matching: \"$pat\""
    fi
  done
  check_assignments "$combined" "commit $sha"
  # Portable: C locale + POSIX classes. Do not use grep -P (missing PCRE
  # used to make this check a silent no-op and let non-ASCII commits through).
  set +e
  printf '%s\n' "$msg" | LC_ALL=C grep -qn -- '[^[:cntrl:][:print:]]'
  nonascii_rc=$?
  set -e
  if [ "$nonascii_rc" -ge 2 ]; then
    die "commit $sha: non-ASCII check failed to run (grep exit $nonascii_rc). Refusing to proceed."
  fi
  if [ "$nonascii_rc" -eq 0 ]; then
    die "commit $sha has non-ASCII characters in message. English only."
  fi
}

# Pre-push hook input is one line per ref being pushed, four space-separated
# fields: <local ref> <local sha> <remote ref> <remote sha>.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  if [ -z "$local_sha" ] || [ -z "$remote_ref" ] || [ -z "$remote_sha" ]; then
    die "malformed pre-push input line: '$local_ref $local_sha $remote_ref $remote_sha'"
  fi
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue # branch deletion — nothing is pushed, nothing to scan
  fi
  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    # New ref (new branch or tag): the remote has no counterpart, so only
    # commits it does not already own are outgoing. Exclude everything
    # reachable from any remote-tracking ref; otherwise a tag push would
    # rescan the entire local history, including old commits the remote
    # already has (e.g. pre-ASCII-message history).
    rev_args=("$local_sha" "--not" "--remotes")
  else
    rev_args=("$local_sha" "^$remote_sha")
  fi
  if ! rev_list=$(git rev-list "${rev_args[@]}" 2>&1); then
    die "git rev-list failed for $local_ref -> $remote_ref: $rev_list"
  fi
  if [ -n "$rev_list" ]; then
    while read -r sha; do
      scan_commit "$sha"
    done <<< "$rev_list"
  fi
done

exit 0
